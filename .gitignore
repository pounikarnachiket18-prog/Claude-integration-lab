# Secrets: never upload these
.env
*.env

# Python virtual environment (each person creates their own)
.venv/

# Python cache files (created automatically, not needed in git)
__pycache__/
*.pyc

# Editor / OS clutter
.DS_Store
.vscode/
.idea/

# Rendered video shots: big files that the scripts can rebuild any time
06-ai-video/**/shots/
06-ai-video/**/renders/

# RBI documentary source media: third-party images and clips, not for a public repo
06-ai-video/06-rbi-documentary/assets/
